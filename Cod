def mostrar_carrinho(carrinho):
    print("\n--- SEU CARRINHO ---")
    if not carrinho:
        print("  (vazio)")
    for numero, (item, qtd) in enumerate(carrinho.items(), start=1):
        print(f"  {numero}. {qtd} x {item}")


def adicionar_ao_carrinho(carrinho, item, qtd):
    carrinho[item] = min(carrinho.get(item, 0) + qtd, QTD_MAXIMA)
    print(f"  [+] Adicionado: {item} (no carrinho: {carrinho[item]})")


def escolher_item(carrinho, categoria):
    """Lista os itens de uma categoria e põe no carrinho o que a pessoa escolher."""
    while True:
        print(f"\n--- {categoria['nome']} ---")
        if categoria.get("nota"):
            print(textwrap.fill("Obs.: " + categoria["nota"], LARGURA))
        escolha = menu("Qual item?", categoria["itens"], "Voltar às categorias")
        if escolha == 0:
            return
        item = categoria["itens"][escolha - 1]
        qtd = ler_inteiro("Quantidade (Enter = 1): ", 1, QTD_MAXIMA, padrao=1)
        adicionar_ao_carrinho(carrinho, item, qtd)


def adicionar_outro(carrinho):
    """Só para quem vai doar: item que não está na lista."""
    while True:
        texto = limpar_texto(input("Qual item você quer doar? (Enter para cancelar): "))
        if texto == "":
            print("  Nada foi adicionado.")
            return
        if len(texto) <= TAM_MAXIMO_OUTRO:
            break
        print(f"  Descrição muito longa (máximo de {TAM_MAXIMO_OUTRO} caracteres).")
    qtd = ler_inteiro("Quantidade (Enter = 1): ", 1, QTD_MAXIMA, padrao=1)
    adicionar_ao_carrinho(carrinho, "Outro: " + texto[0].upper() + texto[1:], qtd)


def gerenciar_carrinho(carrinho):
    """Ver o carrinho e alterar: mudar quantidade, remover um item ou esvaziar."""
    while True:
        mostrar_carrinho(carrinho)
        if not carrinho:
            return
        escolha = menu(
            "O que deseja fazer?",
            ["Alterar quantidade", "Remover um item", "Esvaziar o carrinho"],
            "Voltar",
        )
        if escolha == 0:
            return
        if escolha == 3:
            if confirmar("Remover todos os itens?"):
                carrinho.clear()
            continue
        numero = ler_inteiro("Número do item (0 para cancelar): ", 0, len(carrinho))
        if numero == 0:
            continue
        item = list(carrinho)[numero - 1]
        if escolha == 1:
            carrinho[item] = ler_inteiro(f"Nova quantidade de '{item}': ", 1, QTD_MAXIMA)
        else:
            del carrinho[item]
            print(f"  [-] Removido: {item}")


def finalizar(nome, tipo, carrinho):
    """Confirma, salva no banco, agradece e avisa. Devolve True se concluiu."""
    if not carrinho:
        print("\n  Seu carrinho está vazio. Adicione pelo menos um item para finalizar.")
        return False

    mostrar_carrinho(carrinho)
    if not confirmar("Confirmar e finalizar?"):
        print("  Tudo bem, o carrinho continua aberto para você alterar.")
        return False

    try:
        avisos = salvar_registro(nome, tipo, carrinho)
    except sqlite3.Error as erro:
        print(f"\n  Não foi possível salvar agora ({erro}). Tente finalizar de novo.")
        return False

    if tipo == "doacao":
        caixa(f"Doação registrada, {nome}!",
              "Você está ajudando quem precisa. Obrigado.")
        if avisos:
            print("\n  AVISO: tem gente esperando por itens da sua doação:")
            for item, qtd in avisos:
                print(f"   - {qtd} x {item}")
    else:
        caixa(f"Pedido registrado, {nome}!")
        if avisos:
            print("\n  AVISO: já existe doação registrada de:")
            for item, qtd in avisos:
                print(f"   - {qtd} x {item}")
        print("\n  Itens sem doação ficam na lista: quem doar será avisado.")
    return True


def fluxo_carrinho(nome, tipo):
    """Fluxo de 'Quero doar' (tipo 'doacao') e de 'Preciso de uma doação'
    (tipo 'pedido'). É o mesmo fluxo; só quem doa tem a opção 'Outro'."""
    doando = tipo == "doacao"
    carrinho = {}  # item -> quantidade (mantém a ordem em que foram adicionados)

    titulo("QUERO DOAR" if doando else "PRECISO DE UMA DOAÇÃO")
    if doando:
        print(textwrap.fill(DICA, LARGURA))

    total_categorias = len(CATEGORIAS)
    pos_outro = total_categorias + 1 if doando else None
    pos_carrinho = total_categorias + (2 if doando else 1)
    pos_finalizar = pos_carrinho + 1

    while True:
        opcoes = [categoria["nome"] for categoria in CATEGORIAS]
        if doando:
            opcoes.append("Outro (item que não está na lista)")
        opcoes.append(f"Ver / alterar carrinho [{len(carrinho)}]")
        opcoes.append("Finalizar")

        pergunta = "O que você quer doar?" if doando else "Do que você precisa?"
        escolha = menu(pergunta, opcoes, "Voltar ao menu")

        if escolha == 0:
            if not carrinho or confirmar("Voltar ao menu e descartar o carrinho?"):
                return
        elif escolha <= total_categorias:
            escolher_item(carrinho, CATEGORIAS[escolha - 1])
        elif escolha == pos_outro:
            adicionar_outro(carrinho)
        elif escolha == pos_carrinho:
            gerenciar_carrinho(carrinho)
        elif escolha == pos_finalizar:
            if finalizar(nome, tipo, carrinho):
                return


def ver_itens():
    """Opção 2 do menu: mostra os itens e espera a pessoa digitar 1 para voltar."""
    titulo("ITENS PARA DOAÇÃO")
    for numero, categoria in enumerate(CATEGORIAS, start=1):
        print(f"\n{numero}. {categoria['nome']}")
        for item in categoria["itens"]:
            print(f"   - {item}")
        if categoria.get("nota"):
            print(textwrap.fill("Obs.: " + categoria["nota"], LARGURA,
                                initial_indent="   ", subsequent_indent="         "))
    print("\n" + textwrap.fill(DICA, LARGURA))
    print("\n  1 - Voltar para a página de antes")
    while input("Escolha uma opção: ").strip() != "1":
        print("  Opção inválida. Digite 1 para voltar.")


