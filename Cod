# Banco de dados (SQLite)
# ---------------------------------------------------------------------------
# Saldo por item: tudo o que foi doado menos tudo o que foi pedido.
# Positivo = sobrou doação; negativo = tem pedido sem atender.
SQL_SALDO = """
    SELECT i.item,
           SUM(CASE r.tipo WHEN 'doacao' THEN i.quantidade ELSE -i.quantidade END)
    FROM itens i
    JOIN registros r ON r.id = i.registro_id
    GROUP BY i.item
"""


def conectar():
    """Abre o banco (criando o arquivo e as tabelas na primeira vez)."""
    conexao = sqlite3.connect(str(ARQUIVO_BANCO))
    conexao.execute("PRAGMA foreign_keys = ON")
    conexao.executescript(
        """
        CREATE TABLE IF NOT EXISTS registros (
            id        INTEGER PRIMARY KEY AUTOINCREMENT,
            data_hora TEXT NOT NULL,
            nome      TEXT NOT NULL,
            tipo      TEXT NOT NULL CHECK (tipo IN ('doacao', 'pedido'))
        );
        CREATE TABLE IF NOT EXISTS itens (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            registro_id INTEGER NOT NULL REFERENCES registros(id),
            item        TEXT NOT NULL,
            quantidade  INTEGER NOT NULL CHECK (quantidade > 0)
        );
        """
    )
    return conexao


def salvar_registro(nome, tipo, carrinho):
    """Salva a doação/pedido e devolve os avisos: lista de (item, quantidade) do
    carrinho que combinam com o que já estava no banco (pedido x doação)."""
    agora = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with closing(conectar()) as conexao, conexao:  # 'conexao' sozinho = transação
        saldo = dict(conexao.execute(SQL_SALDO).fetchall())  # antes de salvar este
        cursor = conexao.execute(
            "INSERT INTO registros (data_hora, nome, tipo) VALUES (?, ?, ?)",
            (agora, nome, tipo),
        )
        conexao.executemany(
            "INSERT INTO itens (registro_id, item, quantidade) VALUES (?, ?, ?)",
            [(cursor.lastrowid, item, qtd) for item, qtd in carrinho.items()],
        )

    avisos = []
    for item, qtd in carrinho.items():
        # pedido combina com doação que sobrou; doação combina com pedido sem atender
        disponivel = saldo.get(item, 0) if tipo == "pedido" else -saldo.get(item, 0)
        if disponivel > 0:
            avisos.append((item, min(disponivel, qtd)))
    return avisos


def ler_registros():
    """Lê tudo o que está salvo: uma lista com um dicionário por doação/pedido."""
    with closing(conectar()) as conexao:
        linhas = conexao.execute(
            "SELECT id, data_hora, nome, tipo FROM registros ORDER BY id"
        ).fetchall()
        registros = []
        for reg_id, data_hora, nome, tipo in linhas:
            itens = conexao.execute(
                "SELECT quantidade, item FROM itens WHERE registro_id = ? ORDER BY id",
                (reg_id,),
            ).fetchall()
            registros.append({
                "id": reg_id,
                "data": datetime.strptime(data_hora, "%Y-%m-%d %H:%M:%S"),
                "nome": nome,
                "tipo": tipo,
                "itens": itens,  # lista de (quantidade, item)
            })
    return registros


def cabecalho_registro(registro):
    """Primeira linha de cada registro: número, data, tipo e nome."""
    return (f"#{registro['id']}  {registro['data']:%d/%m/%Y %H:%M}  "
            f"{ROTULOS[registro['tipo']]}  -  {registro['nome']}")


def resumo_registros(registros):
    doacoes = sum(1 for r in registros if r["tipo"] == "doacao")
    pedidos = len(registros) - doacoes
    return f"Total: {len(registros)} registro(s) - {doacoes} doação(ões) e {pedidos} pedido(s)."


# ---------------------------------------------------------------------------
# PDF (escrito à mão, só com a biblioteca padrão: não precisa instalar nada)
# ---------------------------------------------------------------------------
PDF_LARGURA, PDF_ALTURA = 595, 842  # página A4, em pontos
PDF_MARGEM = 50
PDF_ENTRELINHA = 15                 # altura de cada linha
PDF_COLUNAS = 68                    # caracteres por linha (com folga para maiúsculas)
NORMAL, NEGRITO = b"F1", b"F2"      # fontes do PDF: Helvetica e Helvetica-Bold


def pdf_texto(texto):
    """Texto -> string de PDF. A codificação cp1252 cobre os acentos do
    português; letras de outros alfabetos viram '?'."""
    dados = texto.encode("cp1252", errors="replace")
    dados = dados.replace(b"\\", b"\\\\").replace(b"(", b"\\(").replace(b")", b"\\)")
    return b"(" + dados + b")"


def linhas_pdf(fonte, tamanho, recuo, texto):
    """Quebra o texto em linhas que cabem na largura da página."""
    partes = textwrap.wrap(texto, PDF_COLUNAS) or [""]
    return [(fonte, tamanho, recuo, parte) for parte in partes]


def paginar(blocos):
    """Distribui os blocos (um registro por bloco) nas páginas. Um bloco só é
    dividido entre duas páginas se não couber inteiro em uma."""
    por_pagina = (PDF_ALTURA - 2 * PDF_MARGEM - 10) // PDF_ENTRELINHA
    paginas = [[]]
    for bloco in blocos:
        livres = por_pagina - len(paginas[-1])
        if len(bloco) > livres and len(bloco) <= por_pagina:
            paginas.append([])
        for linha in bloco:
            if len(paginas[-1]) == por_pagina:
                paginas.append([])
            paginas[-1].append(linha)
    return paginas


def conteudo_pagina(linhas, numero, total):
    """Comandos de desenho de uma página: o texto e o rodapé."""
    comandos = []
    y = PDF_ALTURA - PDF_MARGEM
    for fonte, tamanho, recuo, texto in linhas:
        y -= PDF_ENTRELINHA
        if texto:
            comandos.append(b"BT /%s %d Tf 1 0 0 1 %d %d Tm %s Tj ET"
                            % (fonte, tamanho, PDF_MARGEM + recuo, y, pdf_texto(texto)))
    comandos.append(b"0.5 w %d 40 m %d 40 l S" % (PDF_MARGEM, PDF_LARGURA - PDF_MARGEM))
    comandos.append(b"BT /F1 8 Tf 1 0 0 1 %d 28 Tm %s Tj ET"
                    % (PDF_MARGEM, pdf_texto(f"REPLATE - página {numero} de {total}")))
    return b"\n".join(comandos)


def escrever_pdf(caminho, paginas):
    """Monta o arquivo PDF (objetos + tabela de posições) e grava em 'caminho'."""
    total = len(paginas)
    ids = [5 + 2 * i for i in range(total)]  # nº do objeto de cada página (o conteúdo é o seguinte)
    objetos = [
        b"<< /Type /Catalog /Pages 2 0 R >>",
        b"<< /Type /Pages /Kids [" + b" ".join(b"%d 0 R" % n for n in ids)
        + b"] /Count %d >>" % total,
        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>",
        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>",
    ]
    for i, linhas in enumerate(paginas):
        conteudo = conteudo_pagina(linhas, i + 1, total)
        objetos.append(
            b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 %d %d] "
            b"/Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents %d 0 R >>"
            % (PDF_LARGURA, PDF_ALTURA, ids[i] + 1)
        )
        objetos.append(b"<< /Length %d >>\nstream\n" % len(conteudo) + conteudo + b"\nendstream")
    objetos.append(b"<< /Title " + pdf_texto("REPLATE - Registros salvos")
                   + b" /Producer (REPLATE) >>")

    pdf = bytearray(b"%PDF-1.4\n%\xe2\xe3\xcf\xd3\n")
    posicoes = []
    for numero, corpo in enumerate(objetos, start=1):
        posicoes.append(len(pdf))
        pdf += b"%d 0 obj\n" % numero + corpo + b"\nendobj\n"
    inicio_xref = len(pdf)
    pdf += b"xref\n0 %d\n0000000000 65535 f \n" % (len(objetos) + 1)
    for posicao in posicoes:
        pdf += b"%010d 00000 n \n" % posicao
    pdf += (b"trailer\n<< /Size %d /Root 1 0 R /Info %d 0 R >>\nstartxref\n%d\n%%%%EOF\n"
            % (len(objetos) + 1, len(objetos), inicio_xref))
    Path(caminho).write_bytes(bytes(pdf))


def gerar_pdf_registros(caminho, registros, agora):
    """Monta o PDF com os registros (um bloco por registro) e grava em 'caminho'."""
    blocos = [
        linhas_pdf(NEGRITO, 14, 0, "REPLATE - Registros salvos (admin)")
        + linhas_pdf(NORMAL, 10, 0, f"Gerado em {agora:%d/%m/%Y %H:%M}")
        + linhas_pdf(NORMAL, 10, 0, resumo_registros(registros))
        + linhas_pdf(NORMAL, 10, 0, "")
    ]
    for registro in registros:
        bloco = linhas_pdf(NEGRITO, 10, 0, cabecalho_registro(registro))
        for qtd, item in registro["itens"]:
            bloco += linhas_pdf(NORMAL, 10, 16, f"{qtd} x {item}")
        bloco += linhas_pdf(NORMAL, 10, 0, "")
        blocos.append(bloco)
    escrever_pdf(caminho, paginar(blocos))


