# Entrada de dados (tudo o que a pessoa digita passa por aqui)
# ---------------------------------------------------------------------------
def ler_inteiro(pergunta, minimo, maximo, padrao=None):
    """Repete a pergunta até a pessoa digitar um número inteiro válido.
    Se 'padrao' for dado, apertar só Enter devolve esse valor."""
    while True:
        texto = input(pergunta).strip()
        if texto == "" and padrao is not None:
            return padrao
        try:
            numero = int(texto)
        except ValueError:
            numero = None
        if numero is not None and minimo <= numero <= maximo:
            return numero
        print(f"  Valor inválido. Digite um número de {minimo} a {maximo}.")


def confirmar(pergunta):
    """Pergunta sim/não e devolve True ou False."""
    while True:
        resposta = input(f"{pergunta} (s/n): ").strip().lower()
        if resposta in ("s", "sim"):
            return True
        if resposta in ("n", "nao", "não"):
            return False
        print("  Responda com s (sim) ou n (não).")


def menu(cabecalho, opcoes, voltar):
    """Mostra opções numeradas (1, 2, 3...) e devolve a escolhida. 0 = voltar."""
    print(f"\n{cabecalho}")
    for numero, texto in enumerate(opcoes, start=1):
        print(f"  {numero} - {texto}")
    print(f"  0 - {voltar}")
    return ler_inteiro("Escolha uma opção: ", 0, len(opcoes))


def limpar_texto(texto):
    """Tira espaços sobrando e junta letras com acento 'soltas' (normalização NFC)."""
    return " ".join(unicodedata.normalize("NFC", texto).split())


def nome_valido(nome):
    """Só aceita letras (com acento) e espaços: sem números nem caracteres especiais."""
    return nome != "" and all(c.isalpha() or c == " " for c in nome)


def pedir_nome():
    """Primeiro input: pede o nome até ser válido (ou o código de admin)."""
    while True:
        entrada = limpar_texto(input("Digite o seu nome: "))
        if entrada == CODIGO_ADMIN or nome_valido(entrada):
            return entrada
        print("  Nome inválido: use só letras e espaços (sem números ou "
              "caracteres especiais). Tente de novo.")


