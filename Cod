def salvar_registros_pdf(registros):
    """Opção do admin: grava os registros em um PDF, ao lado do banco de dados.
    O nome leva data e hora, então cada exportação cria um arquivo novo."""
    agora = datetime.now()
    caminho = ARQUIVO_BANCO.with_name(f"registros_replate_{agora:%Y-%m-%d_%H-%M-%S}.pdf")
    try:
        gerar_pdf_registros(caminho, registros, agora)
    except OSError as erro:
        print(f"\n  Não foi possível salvar o PDF ({erro}).")
        return
    print(f"\n  [OK] PDF salvo em: {caminho}")


def gerar_pdf_do_banco():
    """Opção 4 do menu: lê o banco de dados e salva todos os registros em um PDF."""
    try:
        registros = ler_registros()
    except sqlite3.Error as erro:
        print(f"\n  Não foi possível ler o banco de dados: {erro}")
        return
    if not registros:
        print("\n  Nenhum registro salvo ainda: não há nada para colocar no PDF.")
        return
    salvar_registros_pdf(registros)


def modo_admin():
    """Mostra tudo o que está salvo no banco de dados e oferece salvar em PDF."""
    titulo("REGISTROS SALVOS (ADMIN)")
    print(f"Banco de dados: {ARQUIVO_BANCO}")
    try:
        registros = ler_registros()
    except sqlite3.Error as erro:
        print(f"\nNão foi possível ler o banco de dados: {erro}")
        return
    if not registros:
        print("\nNenhum registro salvo ainda.")
        return

    for registro in registros:
        print("\n" + cabecalho_registro(registro))
        for qtd, item in registro["itens"]:
            print(f"     {qtd} x {item}")
    print("\n" + resumo_registros(registros))

    while True:
        if menu("ADMIN", ["Salvar registros em PDF"], "Sair") == 0:
            return
        salvar_registros_pdf(registros)


